{
 	"$schema": "node_modules/wrangler/config-schema.json",
 	"name": "veneth-studio",
 	"compatibility_date": "2025-09-27",
 	"main": "./src/worker/index.ts",
 	"pages_build_output_dir": "./dist",
 	"workers_dev": true,
 	"d1_databases": [
 		{
 			"binding": "DB",
 			"database_name": "veneth-studio",
 			"database_id": "REMOVED"
 		}
 	],
 	"vars": {
 		"ALLOWED_ORIGIN": "*"
 	},
 	"limits": {
 		"rps": 100,
 		"rqpm": 6000
 	},
 	"observability": {
 		"enabled": true
 	}
 }
